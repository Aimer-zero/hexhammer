# hexhammer 配置模板 —— 复制为 .env 后填写:cp .env.example .env
# .env 已被 .gitignore 排除,凭证绝不进 git;也别大段贴进任何对话。

# ============================================================
# 1) LLM 引擎(必须)—— 引擎的脑子
# ============================================================
# 协议:openai(绝大多数网关,含 deepseek 官方)| anthropic(anthropic 兼容网关)
HEXHAMMER_LLM_PROTOCOL=openai

# deepseek 官方示例:
HEXHAMMER_LLM_BASE_URL=https://api.deepseek.com/v1
HEXHAMMER_LLM_API_KEY=sk-把这里换成你的key
HEXHAMMER_LLM_MODEL=deepseek-chat

# 长上下文守卫(默认已内置,一般不用改;改了才会覆盖默认)
# HEXHAMMER_LLM_CONTEXT_WINDOW=1000000
# HEXHAMMER_LLM_MAX_OUTPUT_TOKENS=131072
# HEXHAMMER_LLM_TEMPERATURE=

# ============================================================
# 2) 验证靶标(盲测时填)—— 你自己的云服务器
# ============================================================
# 纪律:只允许填这一个 IP;引擎侦察钉死单目标,绝不扫邻居网段
# HEXHAMMER_TARGET_IP=
# 关联域名(TLS/SNI 探测用;没有可留空)
# HEXHAMMER_TARGET_DOMAIN=
